# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database — any Postgres connection string. Tables are created on first start.
# Supabase: Dashboard → Connect → "Session pooler" URI (IPv4), without ?sslmode:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local:  postgresql://user:password@localhost:5432/interview
DATABASE_URL=
# TLS is on for non-local hosts; set to "false" to force it off (or "true" to force on)
# DATABASE_SSL=

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
# Google Sign-In (optional) — same value as VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=

# AI Provider: "groq" | "mock"
AI_PROVIDER=groq
GROQ_API_KEY=

# Optional Groq overrides (defaults shown). GROQ_MODEL must support strict
# structured outputs (openai/gpt-oss-120b, openai/gpt-oss-20b).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=hannah
# "groq" speaks with Orpheus (falls back to the browser voice on any error);
# "browser" always uses the browser voice
TTS_PROVIDER=groq
